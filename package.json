{
  "name": "video-repo",
  "version": "1.0.0",
  "private": true,
  "description": "Dance Education Platform monorepo",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "build": "npm run build --workspace backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "verify": "npm run verify --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduardoSalasG/video-repo.git"
  },
  "license": "ISC",
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true
  }
}
