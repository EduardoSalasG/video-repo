{
  "name": "video-repo",
  "version": "1.0.0",
  "private": true,
  "description": "Dance Education Platform monorepo",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "build": "npm run build --workspace backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "verify": "npm run verify --workspaces --if-present",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "stack:build": "docker compose build",
    "db:migrate": "npm run prisma:migrate:deploy --workspace backend",
    "db:seed": "npm run seed --workspace backend",
    "db:start": "docker run -d --name video-repo-pg -v C:/Users/salas/Documents/video-repo/db/postgres:/var/lib/postgresql/data -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=admin -e POSTGRES_DB=video_repo -p 5433:5432 postgres:16",
    "db:stop": "docker stop video-repo-pg && docker rm video-repo-pg",
    "db:restart": "npm run db:stop && npm run db:start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduardoSalasG/video-repo.git"
  },
  "license": "ISC",
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
